{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./build",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "removeComments": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "build", "test"]
}
