    "tab_info": {
      "type": "panel",
      "label": {
        "en": "Info",
        "de": "Info"
      },
      "items": {
        "info_title": {
          "type": "staticText",
          "label": {
            "en": "Faikout AC Adapter",
            "de": "Faikout AC Adapter"
          },
          "style": {
            "fontSize": "32px",
            "fontFamily": "xkcd Script, cursive",
            "letterSpacing": "-1px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_desc": {
          "type": "staticText",
          "label": {
            "en": "Connects ioBroker to one or more Faikout devices via an existing MQTT broker. States are updated automatically via MQTT push. Discovery must be triggered manually per device using the Discover button in the Devices tab. States found during discovery are created automatically; states no longer present are removed when discovery is re-run. No states are created or removed in ioBroker without explicitly triggering discovery.",
            "de": "Verbindet ioBroker mit einem oder mehreren Faikout-Devices über einen existierenden MQTT-Broker. Datenpunkte werden automatisch per MQTT aktualisiert. Die Erkennung muss einmalig je Gerät über den Discover-Button im Geräte-Tab ausgelöst werden. Bei der Erkennung gefundene Funktionen werden automatisch als Datenpunkte angelegt oder bei erneuter Ausführung entfernt. Es findet keine Veränderung von Datenpunkten in ioBroker ohne manuelle Ausführung der Erkennung statt."
          },
          "style": {
            "fontSize": "15px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "div_design": {
          "type": "divider"
        },
        "info_design_head": {
          "type": "staticText",
          "label": {
            "en": "Design Principles",
            "de": "Designprinzipien"
          },
          "style": {
            "fontWeight": "bold",
            "fontSize": "22px",
            "fontFamily": "xkcd Script, cursive"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_design_1": {
          "type": "staticText",
          "label": {
            "en": "The adapter communicates with Faikout devices through their native interfaces: MQTT for real-time data and partly HTTP for device discovery.",
            "de": "Der Adapter kommuniziert mit Faikout-Geräten über deren native Schnittstellen: MQTT für Echtzeit-Daten und teils über HTTP für die Geräteerkennung."
          },
          "style": {
            "fontSize": "15px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_design_2": {
          "type": "staticText",
          "label": {
            "en": "There is no dependency on implementation details of any other platform.",
            "de": "Es bestehen keine Abhängigkeiten von Implementierungsdetails anderer Plattformen."
          },
          "style": {
            "fontWeight": "bold",
            "fontSize": "15px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_design_3": {
          "type": "staticText",
          "label": {
            "en": "The MQTT broker already running in the network is used directly, no additional infrastructure required. The Faikout device remains accessible to other automation platforms at the same time, in the spirit of an open platform approach rather than a device-specific standalone solution.",
            "de": "Der im Netzwerk vorhandene MQTT-Broker wird direkt genutzt, ohne zusätzliche Infrastruktur. Das Faikout-Gerät bleibt damit gleichzeitig für andere Automatisierungsplattformen zugänglich, im Sinne einer offenen Plattformlösung und nicht einer gerätespezifischen Einzellösung."
          },
          "style": {
            "fontSize": "15px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "div_prereq": {
          "type": "divider"
        },
        "info_prereq_head": {
          "type": "staticText",
          "label": {
