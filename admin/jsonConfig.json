        },
        "info_options_config_head": {
          "type": "staticText",
          "label": {
            "en": "Config states",
            "de": "Config-Datenpunkte"
          },
          "style": {
            "fontWeight": "bold"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_options_config_1": {
          "type": "staticText",
          "label": {
            "en": "Write-only states are created under {Name}.config.* for Faikout device configuration parameters. Writing a value sends it to the device immediately – there is no read-back or confirmation in ioBroker. Some parameters take effect immediately, others require a device restart. Use with care.",
            "de": "Unter {Name}.config.* werden Nur-Schreiben-Datenpunkte für Faikout-Geräteparameter angelegt. Ein geschriebener Wert wird sofort an das Gerät gesendet – es gibt keine Rücklesefunktion oder Bestätigung in ioBroker. Manche Parameter wirken sofort, andere erfordern einen Neustart. Bitte mit Bedacht verwenden."
          },
          "style": {
            "fontSize": "15px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_options_envset_head": {
          "type": "staticText",
          "label": {
            "en": "env_set – External temperature input",
            "de": "env_set – Externer Temperatureingang"
          },
          "style": {
            "fontWeight": "bold"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_options_envset_1": {
          "type": "staticText",
          "label": {
            "en": "env_set allows an external temperature value (e.g. from a room sensor) to be written to the Faikout device. The device uses this value in its control logic as an environment reference temperature. The state can be written from an automation at the desired interval – the adapter forwards the value immediately.",
            "de": "env_set ermöglicht es, einen externen Temperaturwert (z.B. eines Raumsensors) an das Faikout-Gerät zu schreiben. Das Gerät verwendet diesen Wert in seiner Regellogik als Umgebungsreferenztemperatur. Der Datenpunkt kann aus einer Automation im gewünschten Intervall beschrieben werden – der Adapter leitet den Wert sofort weiter."
          },
          "style": {
            "fontSize": "15px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_options_envset_2": {
          "type": "staticText",
          "label": {
            "en": "The Faikout device expects a fresh env_set value within a 300-second window – if no value arrives in time, the external sensor and its influence on the control logic are discarded.",
            "de": "Das Faikout-Gerät erwartet innerhalb eines 300-Sekunden-Fensters einen aktuellen env_set-Wert – bleibt dieser aus, werden der externe Sensor und dessen Berücksichtigung in der Regellogik verworfen."
          },
          "style": {
            "fontSize": "15px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "info_options_envset_3": {
          "type": "staticText",
          "label": {
            "en": "Alternatively the tab 'External Sensor' is available.",
            "de": "Alternativ steht der Tab 'Externer Sensor' zur Verfügung."
          },
          "style": {
            "fontSize": "15px"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "div_version": {
          "type": "divider"
        },
        "info_version": {
          "type": "staticText",
          "label": {
            "en": "v0.1.33",
            "de": "v0.1.33"
          },
          "style": {
            "fontSize": "11px",
            "color": "#aaa",
            "textAlign": "right"
          },
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
