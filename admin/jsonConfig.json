        "info_setup_1b": {
          "type": "staticText",
          "label": {
            "en": "   · Demand Control and/or Humidity Control checkboxes: activate per device as needed",
            "de": "   · Checkboxen Bedarfssteuerung und/oder Feuchte Regelung je Gerät aktivieren falls gewünscht"
