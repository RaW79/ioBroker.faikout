        "info_setup_1": {
          "type": "staticText",
          "label": {
            "en": "1. Devices tab: add one row per Faikout device (name and IP address)",
            "de": "1. Geräte-Tab: eine Zeile je Faikout-Gerät anlegen (Name und IP-Adresse)"
