        "info_setup_4": {
          "type": "staticText",
          "label": {
            "en": "4. Click Discover per device to run detection and create states",
            "de": "4. Je Gerät auf Erkennen klicken, um die Erkennung zu starten und Datenpunkte anzulegen"
