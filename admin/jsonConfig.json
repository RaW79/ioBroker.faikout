        "info_setup_1c": {
          "type": "staticText",
          "label": {
            "en": "   · Multi-split: assign all indoor units of the same outdoor unit to the same group (A–E); single-split devices stay on Single-Split",
            "de": "   · Multisplit: alle Innengeräte desselben Außengeräts auf dieselbe Gruppe (A–E) setzen; Single-Split-Geräte bleiben auf Single-Split"
