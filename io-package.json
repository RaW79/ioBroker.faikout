{
  "common": {
    "name": "faikout-ac",
    "version": "0.1.5",
    "news": {
      "0.1.5": {
        "en": "Schedule modes, adapter title fix, language detection fix",
        "de": "Zeitplan-Modi, Adapter-Titel korrigiert, Spracherkennung behoben"
      },
      "0.1.4": {
        "en": "Full bilingual UI (EN/DE) for all admin tabs",
        "de": "Vollstaendige zweisprachige Oberflaeche (EN/DE) fuer alle Admin-Tabs"
      }
    },
    "titleLang": {
      "en": "Faikout AC",
      "de": "Faikout AC"
    },
    "desc": {
      "en": "Adapter for Faikout Daikin MQTT bridge",
      "de": "Adapter fuer Faikout Daikin MQTT-Bridge"
    },
    "authors": ["RWS <wizmann@gmx.de>"],
    "keywords": ["faikout", "daikin", "climate-control", "mqtt"],
    "platform": "Javascript/Node.js",
    "icon": "faikout.png",
    "extIcon": "https://raw.githubusercontent.com/RaW79/ioBroker.faikout-ac/main/admin/faikout.png",
    "enabled": true,
    "mode": "daemon",
    "type": "climate-control",
    "connectionType": "local",
    "dataSource": "push",
    "compact": true,
    "tier": 3,
    "messagebox": true,
    "adminUI": {
      "config": "json"
    },
    "readme": "https://github.com/RaW79/ioBroker.faikout-ac#readme",
    "licenseInformation": {
      "type": "free",
      "license": "MIT",
      "link": "https://opensource.org/licenses/MIT"
    },
    "dependencies": [
      { "js-controller": ">=6.0.11" }
    ],
    "globalDependencies": [
      { "admin": ">=7.6.17" }
    ]
  },
  "native": {
    "mqttHost": "localhost",
    "mqttPort": 1883,
    "mqttUser": "",
    "mqttPassword": "",
    "devices": [],
    "demandEnabled": false,
    "demandDevice": "",
    "demandOutdoorTempId": "",
    "demandRoomTempId": "",
    "demandCurve": [
      { "temp": -5, "demand": 80 },
      { "temp":  0, "demand": 75 },
      { "temp":  5, "demand": 65 },
      { "temp": 10, "demand": 55 },
      { "temp": 15, "demand": 30 }
    ],
    "demandLogLevel": "basic",
    "demandMaxDemand": 95,
    "demandBoostEnabled": true,
    "demandBoostStages": [
      { "deviation": 0.3, "boost": 5  },
      { "deviation": 0.6, "boost": 10 }
    ],
    "demandTaperEnabled": true,
    "demandTaperMax": 15,
    "demandGuardEnabled": true,
    "demandHeatbackNormal": 3,
    "demandHeatbackGuard": 6
  },
  "encryptedNative": ["mqttPassword"],
  "protectedNative": ["mqttPassword"],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information",
        "role": "info"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": {
          "en": "Connection",
          "de": "Verbindung"
        },
        "role": "indicator.connected",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
